# -*- mode: conf; coding: utf-8 -*-

# load PyEndpoint and Serial Endpoint support
Ice.Plugin.PyEndpoint = IcePyEndpoint:addPyEndpointSupport
PyEndpoint.Module = SerialEndpoint
PyEndpoint.Factory = EndpointFactoryI

# router settings
Router.Ids = A00A0001
Router.Table.Path = router.table
Router.Adapter.Endpoints = tcp -h 127.0.0.1 -p 6140 : serial -h 127.0.0.1 -p 1793

# common Ice settings
Ice.MessageSizeMax = 7168
