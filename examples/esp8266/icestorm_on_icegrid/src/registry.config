IceGrid.InstanceName = TestIceGrid

IceGrid.Registry.Client.Endpoints = tcp -h 192.168.4.2 -p 4061
IceGrid.Registry.Server.Endpoints = tcp -h localhost
IceGrid.Registry.Internal.Endpoints = tcp -h localhost
IceGrid.Registry.Data = /tmp/test-registry
IceGrid.Registry.PermissionsVerifier = TestIceGrid/NullPermissionsVerifier
IceGrid.Registry.AdminPermissionsVerifier = TestIceGrid/NullPermissionsVerifier
IceGrid.Registry.DefaultTemplates = /usr/share/Ice-3.6.3/templates.xml
IceGrid.Registry.Trace.Node = 1
IceGrid.Registry.Trace.Replica = 1

Ice.ProgramName = icegridregistry (TestIceGrid Master)
